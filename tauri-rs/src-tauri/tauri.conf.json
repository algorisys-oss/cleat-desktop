{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cleat",
  "version": "0.4.1",
  "identifier": "dev.rajesh.cleat",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Cleat Cockpit",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/algorisys-oss/cleat-desktop/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhFNUUxNDUzOEU5MUFBMUQKUldRZHFwR09VeFJlamxBTU9BV0VHTTNCcXhIUkRzQ2ZCYmxlQVdCQXpqTk15TTBqczBCdE44MWQK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "license": "MIT",
    "licenseFile": "../../LICENSE",
    "copyright": "Copyright (c) 2026 Rajesh Pillai",
    "publisher": "Rajesh Pillai",
    "homepage": "https://github.com/algorisys-oss/cleat-desktop",
    "category": "DeveloperTool",
    "shortDescription": "Container management for Docker and Podman",
    "longDescription": "A fast, native desktop app for managing Docker and Podman containers side by side from one window: containers, live logs and stats, an interactive terminal, images, networks, volumes and compose.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
